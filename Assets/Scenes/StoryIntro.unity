  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryIntroController
  backgroundArt: {fileID: 2016007193}
  quoteScreen: {fileID: 1030991168}
  quoteText: {fileID: 1450510766}
  quoteSubText: {fileID: 0}
  textBand: {fileID: 1540610459}
  narrationText: {fileID: 1559683959}
  continueButton: {fileID: 2091589413}
  skipButton: {fileID: 157390230}
  fadeOverlay: {fileID: 485959921}
  beatFadeSeconds: 0.4
  typewriterCharsPerSecond: 45
  quoteLine: Every monster was once someone's hero.
  quoteSubLine: "\u2014 from the sealed chronicles of the Dungeon Core"
  pages:
  - image: {fileID: -855298285791758126, guid: f4a0527a45388ec498b6158b53fe70ec, type: 3}
    narration: "A thousand years ago, you were no Demon Lord. You were Alaric \u2014
      the greatest Paladin who ever lived, leading six chosen heroes into the deepest
      abyss to destroy the old Demon Lord."
  - image: {fileID: 6937817954938267909, guid: 49e9ba4e336276e47b1c4741fd766629, type: 3}
    narration: And the Demon Lord fell. The abyss went silent. The world was saved,
      and victory belonged to you and your companions.
  - image: {fileID: -6470460504253458178, guid: 5298a44e9f4717d4ebc5bc3756291c5e, type: 3}
    narration: "But greed poisons even the bravest hearts. Fearing your power, your
      six companions struck you down at the heart of the Dungeon Core. They branded
      you 'the one who surrendered to darkness,' sealed your soul within the core,
      and offered your body as a sacrifice \u2014 fuel to sustain humankind's prosperity
      for a thousand years."
  gameplaySceneName: Phase 1
